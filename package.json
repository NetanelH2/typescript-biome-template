{
	"name": "typescript-biome-template",
	"version": "1.0.0",
	"description": "A TypeScript project template with Biome for linting and formatting",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"dev": "ts-node src/index.ts",
		"build": "tsc",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"type-check": "tsc --noEmit",
		"prepare": "husky"
	},
	"keywords": [
		"typescript",
		"biome",
		"template"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.3.6",
		"@types/node": "^24.10.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
